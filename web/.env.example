# The historical/quote data source (Yahoo Finance's public chart endpoint)
# needs no key, so nothing here is required to run the app locally or on
# Vercel. These exist for a possible future real-time-WebSocket phase.

# Optional, server-side only — never exposed to the browser bundle.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=

# How often the client polls /api/quote for a price update (seconds).
NEXT_PUBLIC_POLLING_INTERVAL_SECONDS=5
